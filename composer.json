{
  "name": "baptchau/feature-manager",
  "description": "Feature flag manager configured from a YAML file",
  "type": "library",
  "keywords": ["feature-flag", "feature-toggle", "yaml"],
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "BaptChau",
      "email": "chaudron964+github@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "BaptChau\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BaptChau\\Test\\": "test/"
    }
  },
  "bin": [
    "bin/validate-flags"
  ],
  "require-dev": {
    "phpunit/phpunit": "10.2"
  },
  "require": {
    "php": ">=8.2",
    "symfony/yaml": "^7.0"
  }
}
